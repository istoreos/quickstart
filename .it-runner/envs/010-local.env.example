# Copy this file to .it-runner/envs/010-local.env for machine-local overrides.
#
# DEPLOY_TARGET=quickstart-dev
# SSH_TARGET=root@192.168.9.215
# SSH_PORT=22
# SSH_EXTRA_OPTS=-o StrictHostKeyChecking=no
# SCP_EXTRA_OPTS=-O
# REMOTE_BINARY=/usr/sbin/quickstart
# REMOTE_SERVICE=/etc/init.d/quickstart
# LOCAL_WEB_ZIP=/path/to/quickstart/web/dist/quickstart_web.zip
# ASSET_VERSION=0.14.0-candidate-local
# ALLOW_CRITICAL_GATEWAY_DEPLOY=0
