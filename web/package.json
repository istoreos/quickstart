{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && npm run builds",
    "builds": "vite build && npm run zip",
    "preview": "vite preview",
    "test": "node --test test/*.test.cjs",
    "tsc": "vue-tsc --noEmit",
    "gettext": "vue-gettext-extract && vue-gettext-compile",
    "zip": "rm -f dist/quickstart_web.zip dist/luci-static/.DS_Store && (cd dist && zip -r quickstart_web.zip luci-static)"
  },
  "dependencies": {
    "axios": "1.21.0",
    "echarts": "6.1.0",
    "ipaddr.js": "^2.0.1",
    "pinia": "2.3.1",
    "sass": "^1.45.1",
    "vue": "3.5.44",
    "vue-router": "^4.0.12",
    "vue3-gettext": "^2.2.3",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.13"
  }
}
